---
import SiteLayout from '../layouts/SiteLayout.astro';
import { practice, prices, hours } from '../data/practice.js';
const description = `Bodywork Practice Demo: training content only. Book a bodywork session with Samuel Morgan in London. Introductory session £${prices.introductory}, 50–60 minutes.`;
---
<SiteLayout title="Book a Session" description={description}>
<style is:global slot="head">
    /* -----------------------------------------------
       Book page — local styles
       ----------------------------------------------- */
    .booking-layout {
      display: grid;
      grid-template-columns: 1fr 1fr;
      align-items: start;
      gap: 0;
    }

    /* Details panel */
    .booking-details {
      background: var(--tan);
      padding: calc(var(--nav-height) + 5rem) 5rem 6rem;
    }

    .booking-details h1 {
      font-style: italic;
      font-weight: 300;
      margin-bottom: 3rem;
    }

    .detail-block {
      margin-bottom: 2.5rem;
    }

    .detail-label {
      font-family: 'Inter', sans-serif;
      font-size: 0.65rem;
      font-weight: 400;
      letter-spacing: 0.14em;
      text-transform: uppercase;
      color: var(--sage);
      display: block;
      margin-bottom: 0.6rem;
    }

    .detail-value {
      font-family: 'Cormorant Garamond', serif;
      font-size: 1.25rem;
      font-weight: 300;
      color: var(--charcoal);
      line-height: 1.5;
    }

    .detail-value.small {
      font-family: 'Inter', sans-serif;
      font-size: 0.88rem;
      font-weight: 300;
      color: #555;
      line-height: 1.85;
    }

    .hours-grid {
      display: grid;
      grid-template-columns: auto 1fr;
      gap: 0.3rem 1.2rem;
      margin-top: 0.2rem;
    }

    .hours-day {
      font-family: 'Inter', sans-serif;
      font-size: 0.85rem;
      font-weight: 400;
      color: var(--charcoal);
    }

    .hours-time {
      font-family: 'Inter', sans-serif;
      font-size: 0.85rem;
      font-weight: 300;
      color: #666;
    }

    .detail-divider {
      border: none;
      border-top: 1px solid rgba(44, 44, 44, 0.1);
      margin: 2.5rem 0;
    }

    /* Contact / form panel */
    .booking-form-panel {
      background: var(--cream);
      padding: calc(var(--nav-height) + 5rem) 5rem 6rem;
    }

    .booking-form-panel h2 {
      font-style: italic;
      font-weight: 300;
      margin-bottom: 0.6rem;
    }

    .booking-form-panel .form-intro {
      font-size: 0.88rem;
      font-weight: 300;
      color: #666;
      margin-bottom: 3rem;
      line-height: 1.75;
      max-width: none;
    }

    /* Direct contact */
    .direct-contact {
      margin-bottom: 3rem;
      padding-bottom: 3rem;
      border-bottom: 1px solid rgba(44, 44, 44, 0.1);
    }

    .contact-line {
      display: flex;
      align-items: baseline;
      gap: 0.8rem;
      margin-bottom: 0.7rem;
    }

    .contact-method {
      font-family: 'Inter', sans-serif;
      font-size: 0.65rem;
      font-weight: 400;
      letter-spacing: 0.12em;
      text-transform: uppercase;
      color: var(--sage);
      min-width: 52px;
    }

    .contact-value {
      font-family: 'Inter', sans-serif;
      font-size: 0.9rem;
      font-weight: 300;
      color: var(--charcoal);
    }

    .contact-value a {
      color: var(--charcoal);
      transition: color 0.2s;
    }

    .contact-value a:hover {
      color: var(--sage);
    }

    /* Form */
    .contact-form {
      display: flex;
      flex-direction: column;
      gap: 1.4rem;
    }

    .form-group {
      display: flex;
      flex-direction: column;
      gap: 0.5rem;
    }

    .form-group label {
      font-family: 'Inter', sans-serif;
      font-size: 0.68rem;
      font-weight: 400;
      letter-spacing: 0.12em;
      text-transform: uppercase;
      color: var(--sage);
    }

    .form-group input,
    .form-group textarea {
      background: transparent;
      border: none;
      border-bottom: 1px solid rgba(44, 44, 44, 0.2);
      padding: 0.6rem 0;
      font-family: 'Inter', sans-serif;
      font-size: 0.92rem;
      font-weight: 300;
      color: var(--charcoal);
      outline: 3px solid transparent;
      outline-offset: 3px;
      transition: border-color 0.2s;
      width: 100%;
      border-radius: 0;
      -webkit-appearance: none;
    }

    .form-group input:focus,
    .form-group textarea:focus {
      border-bottom-color: var(--sage);
    }

    .form-group input:focus-visible,
    .form-group textarea:focus-visible {
      outline-color: var(--sage);
    }

    .form-group input::placeholder,
    .form-group textarea::placeholder {
      color: #666;
      font-weight: 300;
    }

    .form-group textarea {
      resize: none;
      height: 120px;
      line-height: 1.7;
    }

    .form-privacy-note {
      font-size: 0.78rem;
      font-weight: 300;
      color: #666;
      line-height: 1.6;
      max-width: none;
    }

    .form-submit {
      margin-top: 0.6rem;
    }

    /* WhatsApp */
    .whatsapp-block {
      margin-bottom: 3rem;
      padding-bottom: 3rem;
      border-bottom: 1px solid rgba(44, 44, 44, 0.1);
    }

    .whatsapp-prompt {
      font-size: 0.82rem;
      font-weight: 300;
      color: #666;
      margin-bottom: 1rem;
      max-width: none;
    }

    .btn-whatsapp {
      display: inline-block;
      font-family: 'Inter', sans-serif;
      font-size: 0.72rem;
      font-weight: 400;
      letter-spacing: 0.12em;
      text-transform: uppercase;
      padding: 0.9rem 2.2rem;
      background: var(--sage);
      color: white;
      border: 1px solid var(--sage);
      transition: background 0.22s ease, color 0.22s ease;
      cursor: pointer;
    }

    .btn-whatsapp:hover {
      background: transparent;
      color: var(--sage);
    }

    /* Deposit & policy */
    .booking-policy {
      margin-bottom: 3rem;
      padding: 1.5rem 1.8rem;
      border-left: 2px solid rgba(138, 158, 133, 0.4);
      display: flex;
      flex-direction: column;
      gap: 0.8rem;
    }

    .booking-policy p {
      font-size: 0.82rem;
      font-weight: 300;
      color: #777;
      line-height: 1.75;
      max-width: none;
    }

    /* Responsive */
    @media (max-width: 960px) {
      .booking-layout {
        grid-template-columns: 1fr;
      }

      .booking-details,
      .booking-form-panel {
        padding: calc(var(--nav-height) + 3rem) 1.5rem 4rem;
      }

      .booking-details {
        padding-top: calc(var(--nav-height) + 3rem);
      }
    }
  </style>

    <div class="booking-layout">

      <!-- =============================================
           LEFT — Session details (tan)
           ============================================= -->
      <div class="booking-details">
        <h1>Book a Session</h1><p class="demo-note">Example prices, hours and policies for training only. No bookings or payments are available.</p>

        <div class="detail-block">
          <span class="detail-label">Cost</span>
          <span class="detail-value">£{prices.introductory} introductory session. £{prices.ongoing} thereafter.</span>
        </div>

        <div class="detail-block">
          <span class="detail-label">Duration</span>
          <span class="detail-value">50&ndash;60 minutes</span>
        </div>

        <div class="detail-block">
          <span class="detail-label">Location</span>
          <span class="detail-value">{practice.location}</span>
        </div>

        <div class="detail-block">
          <span class="detail-label">Concessionary rate</span>
          <span class="detail-value small">Available &mdash; please ask when you get in touch.</span>
        </div>

        <hr class="detail-divider">

        <div class="detail-block">
          <span class="detail-label">Hours</span>
          <div class="hours-grid">
            {hours.map(({ day, time }) => <Fragment><span class="hours-day">{day}</span><span class="hours-time">{time.charAt(0).toUpperCase() + time.slice(1)}</span></Fragment>)}
          </div>
        </div>

        <hr class="detail-divider">

        <div class="detail-block">
          <span class="detail-label">Not sure yet?</span>
          <p class="detail-value small">Not sure if this is right for you? Get in touch anyway &mdash; I&rsquo;m happy to answer any questions before you commit to a session. There&rsquo;s no obligation.</p>
        </div>

        <hr class="detail-divider">

        <div class="detail-block">
          <span class="detail-label">Deposit &amp; cancellation</span>
          <p class="detail-value small">A £{prices.deposit} deposit is required to confirm your booking. Payment details sent on confirmation.</p>

          <p class="detail-value small" style="margin-top: 0.6rem;">Cancellation policy: 48 hours notice required to cancel or reschedule. Late cancellations forfeit the deposit. Genuine emergencies handled with discretion.</p>
        </div>
      </div>


      <!-- =============================================
           RIGHT — Contact & form (cream)
           ============================================= -->
      <div class="booking-form-panel">
        <h2>I&rsquo;d love to hear from you.</h2>
        <p class="form-intro">Try the demonstration form below using made-up information. No message will be sent and no reply will follow.</p>

        <!-- Direct contact -->
        <div class="direct-contact">
          <div class="contact-line">
            <span class="contact-method">Phone</span>
            <span class="contact-value"><span>{practice.phone}</span></span>
          </div>
          <div class="contact-line">
            <span class="contact-method">Email</span>
            <span class="contact-value"><span>{practice.email}</span></span>
          </div>
          <div class="contact-line">
            <span class="contact-method">Web</span>
            <span class="contact-value"><span>{practice.website}</span></span>
          </div>
        </div>

        <!-- WhatsApp -->
        <div class="whatsapp-block"><p>Demo WhatsApp: unavailable. Messaging is disabled.</p></div>

        <!-- Contact form -->
        <p id="demo-form-note" class="demo-note">Demonstration only: entries are not sent or saved. Use made-up details only. Without JavaScript, the form stays disabled and no message can be sent.</p>
        <noscript><p>JavaScript is unavailable. This demonstration form is disabled; no message can be sent.</p></noscript>
        <form class="contact-form" aria-describedby="demo-form-note" autocomplete="off" onsubmit="return false">
          <fieldset disabled class="demo-fields">

          <div class="form-group">
            <label for="name">Name</label>
            <input type="text" id="name" name="name" placeholder="Your name" required autocomplete="name">
          </div>

          <div class="form-group">
            <label for="email">Email</label>
            <input type="email" id="email" name="email" placeholder="demo@example.invalid" required autocomplete="email">
          </div>

          <div class="form-group">
            <label for="phone">Phone <span style="text-transform: none; letter-spacing: 0; font-size: 0.65rem; color: #bbb;">(optional)</span></label>
            <input type="tel" id="phone" name="phone" placeholder="Demo phone — leave blank" autocomplete="tel">
          </div>

          <div class="form-group">
            <label for="message">Message</label>
            <textarea id="message" name="message" placeholder="Tell me a little about what has brought you here, or ask anything you'd like to know." required></textarea>
            <p class="form-privacy-note">Do not enter real contact details or medical information.</p>
          </div>

          <div class="form-submit">
            <button type="submit" class="btn btn-sage">Try demo message</button>
          </div>

          </fieldset>
          <p id="demo-form-status" role="status" aria-live="polite"></p>
        </form>
      </div>

    </div>

  
</SiteLayout>
